<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.mytv.bilistart">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />
    <application android:label="小电视开机启动" android:allowBackup="false" android:directBootAware="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".StartupActivity" android:exported="true" android:directBootAware="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
