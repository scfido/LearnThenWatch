<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.mytv.english">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <application android:label="看电视学英语" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".LearningService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="英语答题提醒">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
    </application>
</manifest>
